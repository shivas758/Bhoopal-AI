# Copy to .dev.vars and fill in. Never commit .dev.vars.
# Free key from https://aistudio.google.com/apikey (restrict it to the Gemini API).
GEMINI_API_KEY=
# Optional, free from https://www.data.gov.in (My Account > Generate API key). Prices fall back to Agmarknet 2.0 without it.
DATA_GOV_API_KEY=
# Web Push signing key for the morning weather message (one line of JSON). Add one with:
#   echo "VAPID_PRIVATE_JWK=$(npm run -s vapid)" >> .dev.vars
VAPID_PRIVATE_JWK=
# The owner's analytics page (#/admin): any long random string (`openssl rand -base64 32`). Leave empty to switch the page off.
ADMIN_TOKEN=
# Optional, for the AI section of that page: a Cloudflare API token with "Account Analytics: Read" (My Profile > API Tokens).
CF_ANALYTICS_TOKEN=
